APP_ENV=development
APP_NAME=HiTrendy
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://hitrendy:hitrendy@localhost:5432/hitrendy
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
REDIS_PROVIDER=memory
REDIS_REQUIRED=0
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=hitrendy:development
REDIS_DEFAULT_TTL_SECONDS=300
STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=./storage
STORAGE_TIMEOUT_SECONDS=10
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=hitrendy
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hitrendy-private
AI_PROVIDER=demo
AI_MODEL=demo-v1
AI_BASE_URL=
# Una sola clave OpenAI puede alimentar texto, visión, imágenes y video.
# Se mantiene vacía para que la demo siga funcionando sin credenciales.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_RETRY_BASE_SECONDS=0.5
AI_HTTP_REFERER=
AI_APP_TITLE=HiTrendy
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=openrouter/free
OPENROUTER_BALANCED_MODEL=
OPENROUTER_QUALITY_MODEL=
OPENROUTER_CATALOG_TTL_SECONDS=3600
VISION_PROVIDER=demo
VISION_MODEL=demo-vision-v1
VISION_BASE_URL=
# Si queda vacío, el backend reutiliza OPENAI_API_KEY y OPENAI_BASE_URL.
VISION_API_KEY=
RUN_REAL_AI_SMOKE=0
IMAGE_GENERATION_ENABLED=0
# Para habilitar imágenes OpenAI, usa IMAGE_PROVIDER=openai y el bloque de
# activación descrito en docs/06-implementation/provider-keys.md.
# El adaptador pide output_format=png y lee b64_json, así que solo la familia
# gpt-image-1 sirve aquí; dall-e-3 responde con otro contrato y falla.
# Sugerido: IMAGE_GENERATION_MODEL=gpt-image-1-mini
IMAGE_PROVIDER=demo
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_ALLOWED_MODELS=
IMAGE_GENERATION_DAILY_BUDGET=10
IMAGE_GENERATION_TIMEOUT_SECONDS=120
IMAGE_GENERATION_MAX_BYTES=8000000
IMAGE_GENERATION_MAX_ATTEMPTS=3
# Must exceed IMAGE_GENERATION_TIMEOUT_SECONDS by at least 60s: a slow call is
# not an abandoned one, and reclaiming it early would pay for it twice.
IMAGE_GENERATION_STUCK_AFTER_SECONDS=900
IMAGE_PREFLIGHT_TTL_SECONDS=600
IMAGE_SIGNED_URL_TTL_SECONDS=300
RUN_REAL_IMAGES_SMOKE=0
VIDEO_GENERATION_ENABLED=0
# El demo es offline y determinista: solo es válido en desarrollo y pruebas.
# Para Sora, usa VIDEO_PROVIDER=openai y duraciones 16,20.
VIDEO_PROVIDER=demo
VIDEO_GENERATION_MODEL=
VIDEO_GENERATION_ALLOWED_MODELS=
# Solo se permiten duraciones cortas y explícitas para evitar gasto ilimitado.
VIDEO_GENERATION_ALLOWED_DURATIONS=5,10
# El presupuesto diario limita el número de solicitudes pagadas por workspace.
VIDEO_GENERATION_DAILY_BUDGET=2
# El timeout evita dejar trabajos pagados esperando indefinidamente.
VIDEO_GENERATION_TIMEOUT_SECONDS=120
# El intervalo y el máximo acotan el sondeo y evitan polling infinito.
VIDEO_GENERATION_POLL_INTERVAL_SECONDS=10
VIDEO_GENERATION_MAX_POLL_SECONDS=900
# El límite de bytes protege almacenamiento y memoria al validar respuestas.
VIDEO_GENERATION_MAX_BYTES=40000000
VIDEO_GENERATION_MAX_ATTEMPTS=3
# Debe superar el timeout para no reclamar un worker que aún está trabajando.
VIDEO_GENERATION_STUCK_AFTER_SECONDS=1200
# Las aprobaciones y enlaces caducan pronto para no reutilizar decisiones viejas.
VIDEO_PREFLIGHT_TTL_SECONDS=600
VIDEO_SIGNED_URL_TTL_SECONDS=300
RUN_REAL_VIDEO_SMOKE=0
TREND_ANALYSIS_ENABLED=0
RUN_REAL_TRENDS_SMOKE=0
YOUTUBE_TRENDS_ENABLED=0
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_DAILY_BUDGET=80
YOUTUBE_CACHE_TTL_SECONDS=900
SERPAPI_TRENDS_ENABLED=0
SERPAPI_API_KEY=
SERPAPI_MONTHLY_BUDGET=200
SERPAPI_CACHE_TTL_SECONDS=1800
RSS_TRENDS_ENABLED=0
RSS_TRENDS_ALLOWLIST=[{"identifier":"bbc-news","public_name":"BBC News RSS","feed_url":"https://feeds.bbci.co.uk/news/rss.xml","regions":["GLOBAL"],"categories":[],"enabled":true}]
RSS_CACHE_TTL_SECONDS=900
RSS_MAX_RESPONSE_BYTES=524288
RSS_DNS_TIMEOUT_SECONDS=3
TRENDS_HTTP_TIMEOUT_SECONDS=10
TRENDS_MAX_RESULTS_PER_SOURCE=10
TRENDS_NEGATIVE_CACHE_TTL_SECONDS=60
TRENDS_SCHEDULED_SCOPES=[{"region":"HN","category":null}]
TRENDS_MANUAL_COOLDOWN_SECONDS=3600
TRENDS_STALE_AFTER_SECONDS=86400
ALLOW_PAID_MODEL_FALLBACK=0
MAX_UPLOAD_MB=10
MAX_UPLOAD_PIXELS=25000000
MAX_UPLOAD_EXPANSION_RATIO=200
MAX_REQUEST_BODY_BYTES=12000000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=
FORWARDED_ALLOW_IPS=
CSRF_ENABLED=1
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=1
FRONTEND_URL=http://localhost:3000
EMAIL_PROVIDER=demo
EMAIL_FROM=HiTrendy <no-reply@hitrendy.local>
RESEND_API_KEY=
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# La verificación de correo se mantiene explícitamente desactivada hasta
# configurar un dominio transaccional real para la beta.
EMAIL_VERIFICATION_MODE=disabled
SUPPORT_EMAIL=support@hitrendy.local
PRIVACY_POLICY_VERSION=2026-08-02
TERMS_VERSION=2026-08-02
DATA_RETENTION_DAYS=365
BETA_INVITES_ENABLED=0
BETA_INVITE_TTL_SECONDS=604800
USAGE_ENFORCEMENT_MODE=off
MONTHLY_AI_BUDGET_USD=0
MAX_TEXT_COST_USD=0
MAX_IMAGE_COST_USD=0
MAX_VIDEO_COST_USD=0
COST_ALERT_THRESHOLD_PERCENT=80
ALERT_ERROR_RATE_PERCENT=5
METRICS_ENABLED=1
METRICS_AUTH_TOKEN=
ERROR_TRACKING_PROVIDER=logging
ERROR_TRACKING_DSN=
# Identidades separadas por comas para las CLI administrativas auditadas.
HITRENDY_ADMIN_IDENTITIES=
JWT_SECRET=replace-in-local-env
SESSION_COOKIE_NAME=hitrendy_session
SESSION_TTL_HOURS=168
GOOGLE_SIGN_IN_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Social connections: connecting an account the user already owns. None of these
# variables grant publishing rights, and no endpoint in this wave posts anything.
SOCIAL_CONNECTIONS_ENABLED=0
# Offline provider for local work. Staging and production refuse to boot with it
# on, so a fake account is never presented as a real one.
SOCIAL_DEMO_PROVIDER_ENABLED=0
SOCIAL_OAUTH_STATE_TTL_SECONDS=600
# 32 random bytes, base64. Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Keep it out of version control and out of the frontend. Losing it makes every
# stored token unreadable, which forces users to reconnect but leaks nothing.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Public origin of this backend. Every provider redirect URI must live under it.
SOCIAL_PUBLIC_BACKEND_URL=http://localhost:8000
SOCIAL_HTTP_TIMEOUT_SECONDS=10
INSTAGRAM_CONNECTIONS_ENABLED=0
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/instagram/callback
RUN_REAL_SOCIAL_SMOKE=0
